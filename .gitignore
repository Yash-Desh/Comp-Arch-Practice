# Lecture audio is kept locally only; transcripts in 4_lecture_transcripts/ are what gets tracked.
*.zip
*.mp3
*.m4a
*.wav

# Lecture video is kept locally only; the .srt captions next to each recording are what gets tracked.
*.mp4
*.mov

# The ece552 project phase archives are small course material, so they override the *.zip rule.
# project-phase3.zip stays ignored: it duplicates the extracted project-phase3/ folder and still
# holds the 193 MB of simulation output that was stripped from that folder.
!ece552/Project/*.zip
ece552/Project/project-phase3.zip

# Verilog simulation output does not belong in the mirror.
*.vcd
*.wlf
*.fst
wlft*
work/
verilogsim*.log
verilogsim*.trace
ece552/Project/project-phase3/project-phase3/design/dumpfile_data.img
ece552/Project/project-phase3/project-phase3/ip/out

# ModelSim project state and crash dumps.
*.mpf
*.cr.mti
tcl_stacktrace.txt

# Editor backups of the course-supplied Verilog sources.
*.bak

# The Vcheck style checker ships as compiled classes with no source. Keep the one canonical copy
# under Rule_Checker/ and drop the duplicates the course dump scattered through the project.
*.class
!ece552/Rule_Checker/*.class

# Office lock/recovery files left behind in the course material dump.
~$*
~WRL*.tmp
